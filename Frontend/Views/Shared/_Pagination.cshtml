@model PaginationViewModel

@if (Model.TotalCount > 0)
{
    <div class="list-pagination d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3">
        <span class="text-muted small">
            @Model.TotalCount kaydın @Model.FirstItem-@Model.LastItem arası gösteriliyor
        </span>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Sayfalama">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.Page == 1 ? "disabled" : null)">
                        <a class="page-link" asp-controller="@Model.Controller" asp-action="@Model.Action"
                           asp-all-route-data="@Model.RouteValuesFor(Math.Max(1, Model.Page - 1))" aria-label="Önceki sayfa">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                    @for (var pageNumber = Model.StartPage; pageNumber <= Model.EndPage; pageNumber++)
                    {
                        <li class="page-item @(pageNumber == Model.Page ? "active" : null)">
                            <a class="page-link" asp-controller="@Model.Controller" asp-action="@Model.Action"
                               asp-all-route-data="@Model.RouteValuesFor(pageNumber)">@pageNumber</a>
                        </li>
                    }
                    <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : null)">
                        <a class="page-link" asp-controller="@Model.Controller" asp-action="@Model.Action"
                           asp-all-route-data="@Model.RouteValuesFor(Math.Min(Model.TotalPages, Model.Page + 1))" aria-label="Sonraki sayfa">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    </div>
}
