@model ErrorViewModel
@{
    ViewData["Title"] = "Hata " + Model.StatusCode;
    Layout = "_Layout";
}

<div class="error-page">
    <div class="error-code">@Model.StatusCode</div>
    <div class="error-icon is-danger"><i class="bi bi-bug-fill"></i></div>
    <div class="error-title">Beklenmeyen bir hata oluştu</div>
    <p class="error-message">
        İşlemin sırasında sunucu tarafında bir sorun oluştu. Sayfayı
        yenilemeyi deneyebilir ya da Dashboard'a dönebilirsin.
    </p>
    <div class="error-actions">
        <a asp-controller="Home" asp-action="Index" class="btn btn-brand">
            <i class="bi bi-house-fill"></i> Dashboard'a Dön
        </a>
    </div>
    @if (Model?.ShowRequestId == true)
    {
        <p class="text-muted small mt-4">Request ID: <code>@Model.RequestId</code></p>
    }
</div>
