@model ErrorViewModel
@{
    ViewData["Title"] = "Sayfa Bulunamadı";
    Layout = "_Layout";
}

<div class="error-page">
    <div class="error-code">404</div>
    <div class="error-icon"><i class="bi bi-signpost-split-fill"></i></div>
    <div class="error-title">Bu sayfa bulunamadı</div>
    <p class="error-message">
        Aradığın sayfa taşınmış, silinmiş olabilir ya da hiç var olmadı.
        Belki de yanlış bir makine/kayıt numarasına gittin.
    </p>
    <div class="error-actions">
        <a asp-controller="Home" asp-action="Index" class="btn btn-brand">
            <i class="bi bi-house-fill"></i> Dashboard'a Dön
        </a>
        <a asp-controller="Machines" asp-action="Index" class="btn btn-primary-soft">
            <i class="bi bi-gear-wide-connected"></i> Makineler
        </a>
    </div>
    @if (Model?.ShowRequestId == true)
    {
        <p class="text-muted small mt-4">Request ID: <code>@Model.RequestId</code></p>
    }
</div>
