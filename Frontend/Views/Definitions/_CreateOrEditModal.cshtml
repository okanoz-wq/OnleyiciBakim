@model DefinitionFormViewModel
@{
    var codeMaxLength = Model.Module is "components" or "failure-codes" or "maintenance-types" ? 20 : 50;
    var nameMaxLength = Model.Module is "components" or "maintenance-types" ? 100 : Model.Module == "failure-codes" ? 150 : 200;
}
<div class="modal fade" tabindex="-1" aria-labelledby="definitionModalTitle" aria-hidden="true">
 <div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content">
  <form asp-controller="Definitions" asp-action="Save" method="post" data-modal-form data-refresh-target="definitionTableRegion" data-refresh-url="@Url.Action("Table", new { module = Model.Module })">
   @Html.AntiForgeryToken()<input asp-for="Module" type="hidden" /><input asp-for="Id" type="hidden" />
   <div class="modal-header"><h5 class="modal-title" id="definitionModalTitle">@(Model.Id is null ? "Yeni" : "Düzenle") — @Model.Metadata.Title</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button></div>
   <div class="modal-body"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3">
    @if (Model.Metadata.ParentLabel is not null) { <div class="col-md-12"><label asp-for="ParentId" class="form-label">@Model.Metadata.ParentLabel</label><select asp-for="ParentId" class="form-select"><option value="">Seçiniz</option>@foreach(var p in Model.Parents){<option value="@p.Id">@p.Code — @p.Name</option>}</select></div> }
    <div class="col-md-6"><label asp-for="Code" class="form-label">@Model.Metadata.CodeLabel</label><input asp-for="Code" class="form-control" maxlength="@codeMaxLength" /><span asp-validation-for="Code" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="Name" class="form-label">@Model.Metadata.NameLabel</label><input asp-for="Name" class="form-control" maxlength="@nameMaxLength" /><span asp-validation-for="Name" class="text-danger"></span></div>
    @if (Model.Module == "shifts") { <div class="col-md-6"><label asp-for="StartTime" class="form-label">Başlangıç</label><input asp-for="StartTime" type="time" class="form-control" /></div><div class="col-md-6"><label asp-for="EndTime" class="form-label">Bitiş</label><input asp-for="EndTime" type="time" class="form-control" /></div> }
    @if (Model.Module == "hybrid-parameters") { <div class="col-md-6"><label asp-for="AiWeight" class="form-label">AI Ağırlığı (%)</label><input asp-for="AiWeight" value="@(Model.AiWeight ?? 40)" class="form-control" /></div><div class="col-md-6"><label asp-for="RuleWeight" class="form-label">Kural Ağırlığı (%)</label><input asp-for="RuleWeight" value="@(Model.RuleWeight ?? 60)" class="form-control" /></div> }
    @if (Model.Module == "maintenance-recommendations") { <div class="col-md-4"><label asp-for="Minimum" class="form-label">Minimum Puan</label><input asp-for="Minimum" class="form-control" step="0.01" /></div><div class="col-md-4"><label asp-for="Maximum" class="form-label">Maksimum Puan</label><input asp-for="Maximum" class="form-control" step="0.01" /></div><div class="col-md-4"><label asp-for="RecommendedDays" class="form-label">Önerilen Gün</label><input asp-for="RecommendedDays" class="form-control" /></div> }
    @if (Model.Metadata.SupportsItems) { <div class="col-12"><label class="form-label">Kontrol Maddeleri</label><div id="checklistItems">@for(var i=0;i<Model.Items.Count;i++){<div class="input-group mb-2"><input asp-for="Items[i].Text" class="form-control" /><span class="input-group-text"><input asp-for="Items[i].Required" class="form-check-input mt-0" />&nbsp; Zorunlu</span></div>}</div><button type="button" class="btn btn-sm btn-outline-primary" data-add-checklist-item><i class="bi bi-plus"></i> Madde Ekle</button></div> }
    @if (Model.Module == "components") { <div class="col-md-6"><label asp-for="Type" class="form-label">Bileşen Türü</label><input asp-for="Type" class="form-control" maxlength="50" /></div><div class="col-md-6"><label asp-for="Severity" class="form-label">Kritiklik</label><select asp-for="Severity" class="form-select"><option value="">Seçiniz</option><option>Düşük</option><option>Orta</option><option>Yüksek</option><option>Kritik</option></select></div><div class="col-md-6"><label asp-for="EstimatedLife" class="form-label">Tahmini Ömür</label><input asp-for="EstimatedLife" class="form-control" min="0" /><span asp-validation-for="EstimatedLife" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Unit" class="form-label">Ömür Birimi</label><select asp-for="Unit" class="form-select"><option value="">Seçiniz</option><option>saat</option><option>gün</option><option>ay</option><option>yıl</option><option>çevrim</option><option>adet</option></select></div> }
    @if (Model.Module == "failure-codes") { <div class="col-md-6"><label asp-for="Category" class="form-label">Arıza Kategorisi</label><input asp-for="Category" class="form-control" maxlength="50" /></div><div class="col-md-6"><label asp-for="Severity" class="form-label">Varsayılan Önem</label><select asp-for="Severity" class="form-select"><option value="">Seçiniz</option><option>Düşük</option><option>Orta</option><option>Yüksek</option><option>Kritik</option></select></div><div class="col-md-6"><label asp-for="MachineType" class="form-label">Makine Türü</label><input asp-for="MachineType" class="form-control" maxlength="50" /></div><div class="col-md-6 d-flex align-items-end"><label class="form-check mb-2"><input asp-for="Flag" class="form-check-input" /><span class="form-check-label">Üretimi durdurur</span></label></div> }
    @if (Model.Module == "maintenance-types") { <div class="col-md-6"><label asp-for="Type" class="form-label">Bakım Türü</label><select asp-for="Type" class="form-select"><option value="">Seçiniz</option><option>Önleyici</option><option>Düzeltici</option><option>Kestirimci</option><option>Periyodik</option><option>Acil</option></select></div><div class="col-md-6"><label asp-for="Severity" class="form-label">Varsayılan Öncelik</label><select asp-for="Severity" class="form-select"><option value="">Seçiniz</option><option>Düşük</option><option>Orta</option><option>Yüksek</option><option>Kritik</option></select></div> }
    @if (Model.Module == "checklists") { <div class="col-md-6"><label asp-for="MachineType" class="form-label">Makine Türü</label><input asp-for="MachineType" class="form-control" maxlength="50" /></div> }
    @if (Model.Module is not "components" and not "failure-codes" and not "maintenance-types" and not "checklists" and not "shifts" and not "maintenance-recommendations") { <div class="col-md-6"><label asp-for="Type" class="form-label">Tür / Model</label><input asp-for="Type" class="form-control" /></div> }
    <div class="col-12"><label asp-for="Description" class="form-label">Açıklama</label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div>
    <div class="col-12"><label class="form-check"><input asp-for="Active" class="form-check-input" /><span class="form-check-label">Aktif</span></label></div>
   </div></div>
   <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Vazgeç</button><button type="submit" class="btn btn-brand" data-submit-button><span class="spinner-border spinner-border-sm d-none"></span> Kaydet</button></div>
  </form>
 </div></div>
</div>
