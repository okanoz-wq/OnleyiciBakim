@model DefinitionIndexViewModel
<div class="table-card reveal mt-3">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>@Model.Metadata.CodeLabel</th><th>@Model.Metadata.NameLabel</th>@if (Model.Metadata.ParentLabel is not null) { <th>@Model.Metadata.ParentLabel</th> }<th>Tür/Bilgi</th><th>Durum</th><th class="text-end">İşlemler</th></tr></thead>
            <tbody>
            @if (Model.Rows.Count == 0) { <tr><td colspan="6" class="text-center py-5 text-muted">Kayıt bulunamadı.</td></tr> }
            @foreach (var row in Model.Rows)
            {
                <tr>
                    <td class="fw-semibold">@row.Code</td><td>@row.Name</td>
                    @if (Model.Metadata.ParentLabel is not null) { <td>@(row.ParentName ?? "—")</td> }
                    <td>@(row.Type ?? "—")</td><td><span class="badge @(row.Active ? "text-bg-success" : "text-bg-secondary")">@(row.Active ? "Aktif" : "Pasif")</span></td>
                    <td class="text-end text-nowrap">
                        <button class="btn btn-sm btn-light" title="Detay" data-modal-url="@Url.Action("Details", new { module = Model.Metadata.Module, id = row.Id })"><i class="bi bi-eye"></i></button>
                        <button class="btn btn-sm btn-light" title="Düzenle" data-modal-url="@Url.Action("Edit", new { module = Model.Metadata.Module, id = row.Id })"><i class="bi bi-pencil"></i></button>
                        @if (row.Active) { <button class="btn btn-sm btn-light text-danger" title="Pasife al" data-modal-url="@Url.Action("Delete", new { module = Model.Metadata.Module, id = row.Id })"><i class="bi bi-trash"></i></button> }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
