@model DefinitionIndexViewModel
@{ ViewData["Title"] = Model.Metadata.Title; }
<div class="filter-bar reveal">
    <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap">
        <div>
            <div class="section-title"><i class="bi bi-sliders"></i> @Model.Metadata.Title</div>
            <div class="text-muted small">Yerel SQL Server tanımlarını modal pencerelerden yönetin.</div>
        </div>
        <button class="btn btn-brand" data-modal-url="@Url.Action("Create", new { module = Model.Metadata.Module })"><i class="bi bi-plus-lg"></i> Yeni Kayıt</button>
    </div>
    <form method="get" class="mt-3">
        <input type="hidden" name="module" value="@Model.Metadata.Module" />
        <label class="form-check"><input class="form-check-input" type="checkbox" name="includeInactive" value="true" checked="@Model.IncludeInactive" onchange="this.form.submit()" /> <span class="form-check-label">Pasif kayıtları göster</span></label>
    </form>
</div>
<div id="definitionTableRegion"><partial name="_Table" model="Model" /></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
