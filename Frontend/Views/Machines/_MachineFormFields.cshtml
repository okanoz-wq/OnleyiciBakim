@model MachineFormViewModel
<div class="row g-3">
    <div class="col-md-4"><label asp-for="Code" class="form-label small text-muted fw-semibold"></label><input asp-for="Code" class="form-control" autocomplete="off" /><span asp-validation-for="Code" class="text-danger small"></span></div>
    <div class="col-md-8"><label asp-for="Name" class="form-label small text-muted fw-semibold"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger small"></span></div>
    <div class="col-md-6"><label asp-for="CompanyId" class="form-label small text-muted fw-semibold"></label><select asp-for="CompanyId" class="form-select" data-cascade="company"><option value="">Seçiniz</option>@foreach(var x in Model.Lookups.Companies){<option value="@x.Id">@x.Code · @x.Name</option>}</select><span asp-validation-for="CompanyId" class="text-danger small"></span></div>
    <div class="col-md-6"><label asp-for="BranchId" class="form-label small text-muted fw-semibold"></label><select asp-for="BranchId" class="form-select" data-cascade="branch"><option value="">Seçiniz</option>@foreach(var x in Model.Lookups.Branches){<option value="@x.Id" data-parent="@x.ParentId">@x.Code · @x.Name</option>}</select><span asp-validation-for="BranchId" class="text-danger small"></span></div>
    <div class="col-md-6"><label asp-for="DepartmentId" class="form-label small text-muted fw-semibold"></label><select asp-for="DepartmentId" class="form-select" data-cascade="department"><option value="">Seçiniz</option>@foreach(var x in Model.Lookups.Departments){<option value="@x.Id" data-parent="@x.ParentId">@x.Code · @x.Name</option>}</select><span asp-validation-for="DepartmentId" class="text-danger small"></span></div>
    <div class="col-md-6"><label asp-for="ProductionLineId" class="form-label small text-muted fw-semibold"></label><select asp-for="ProductionLineId" class="form-select" data-cascade="line"><option value="">Seçiniz</option>@foreach(var x in Model.Lookups.ProductionLines){<option value="@x.Id" data-parent="@x.ParentId">@x.Code · @x.Name</option>}</select><span asp-validation-for="ProductionLineId" class="text-danger small"></span></div>
    <div class="col-md-4"><label asp-for="Model" class="form-label small text-muted fw-semibold"></label><input asp-for="Model" class="form-control" /><span asp-validation-for="Model" class="text-danger small"></span></div>
    <div class="col-md-4"><label asp-for="InstallationYear" class="form-label small text-muted fw-semibold"></label><input asp-for="InstallationYear" class="form-control" type="number" min="1900" max="@DateTime.Today.Year" /><span asp-validation-for="InstallationYear" class="text-danger small"></span></div>
    <div class="col-md-4"><label asp-for="Age" class="form-label small text-muted fw-semibold"></label><input asp-for="Age" class="form-control" type="number" min="0" max="200" /><span asp-validation-for="Age" class="text-danger small"></span></div>
    <div class="col-md-4"><label asp-for="Criticality" class="form-label small text-muted fw-semibold"></label><select asp-for="Criticality" class="form-select">@foreach(var x in Model.Lookups.Criticalities){<option value="@x">@x</option>}</select><span asp-validation-for="Criticality" class="text-danger small"></span></div>
    <div class="col-md-4"><label asp-for="Status" class="form-label small text-muted fw-semibold"></label><select asp-for="Status" class="form-select">@foreach(var x in Model.Lookups.Statuses){<option value="@x">@x</option>}</select><span asp-validation-for="Status" class="text-danger small"></span></div>
    <div class="col-md-4"><label asp-for="LastMaintenanceDate" class="form-label small text-muted fw-semibold"></label><input asp-for="LastMaintenanceDate" class="form-control" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" /><span asp-validation-for="LastMaintenanceDate" class="text-danger small"></span></div>
</div>
