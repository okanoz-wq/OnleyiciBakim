@model ManagedMachineDetailsViewModel
<div class="modal fade" id="machineDetailsModal" tabindex="-1" aria-labelledby="machineDetailsTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content app-modal">
            <div class="modal-header">
                <div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <h5 class="modal-title fw-bold mb-0" id="machineDetailsTitle">@Model.Name</h5>
                        <span class="source-badge @(Model.SourceSystem == "ERP" ? "source-erp" : "source-local")">@Model.SourceSystem</span>
                        @if (!Model.CanManage) { <span class="pill pill-neutral"><i class="bi bi-lock-fill"></i> Salt okunur</span> }
                    </div>
                    <div class="small text-muted mt-1">@Model.Code · @Model.Company / @Model.Branch / @Model.Department / @Model.ProductionLine</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3 mb-4">
                    <div class="col-md-3"><div class="detail-stat"><span>Risk</span><strong>@Model.RiskScore.ToString("0.##") · @Model.RiskLevel</strong></div></div>
                    <div class="col-md-3"><div class="detail-stat"><span>Durum</span><strong>@Model.Status</strong></div></div>
                    <div class="col-md-3"><div class="detail-stat"><span>Kritiklik</span><strong>@Model.Criticality</strong></div></div>
                    <div class="col-md-3"><div class="detail-stat"><span>Son Bakım</span><strong>@(Model.LastMaintenanceAt?.LocalDateTime.ToString("dd.MM.yyyy") ?? "—")</strong></div></div>
                </div>
                <ul class="nav nav-tabs app-tabs" role="tablist">
                    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#machineGeneral" type="button">Genel</button></li>
                    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#machineComponents" type="button">Bileşenler (@Model.ComponentCount)</button></li>
                    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#machineFailures" type="button">Arızalar (@Model.FailureCount)</button></li>
                    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#machineMaintenance" type="button">Bakımlar (@Model.MaintenanceCount)</button></li>
                    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#machineTelemetry" type="button">Telemetri (@Model.TelemetryCount)</button></li>
                </ul>
                <div class="tab-content pt-3">
                    <div class="tab-pane fade show active" id="machineGeneral">
                        <dl class="row detail-list mb-0">
                            <dt class="col-sm-3">Model</dt><dd class="col-sm-9">@(Model.Model ?? "Belirtilmemiş")</dd>
                            <dt class="col-sm-3">Kurulum yılı / Yaş</dt><dd class="col-sm-9">@Model.InstallationYear / @Model.Age</dd>
                            <dt class="col-sm-3">ERP referansı</dt><dd class="col-sm-9">@(Model.ErpReferenceId ?? "Yerel kayıt")</dd>
                            <dt class="col-sm-3">Risk analiz sayısı</dt><dd class="col-sm-9">@Model.RiskAnalysisCount</dd>
                        </dl>
                    </div>
                    <div class="tab-pane fade" id="machineComponents"><partial name="_ComponentSummary" model="Model.Components" /></div>
                    <div class="tab-pane fade" id="machineFailures"><partial name="_HistorySummary" model="Model.RecentFailures" /><p class="text-muted small mt-2 mb-0">Son 10 kayıt gösterilir.</p></div>
                    <div class="tab-pane fade" id="machineMaintenance"><partial name="_HistorySummary" model="Model.RecentMaintenances" /><p class="text-muted small mt-2 mb-0">Son 10 kayıt gösterilir.</p></div>
                    <div class="tab-pane fade" id="machineTelemetry">
                        <div class="table-responsive"><table class="table table-sm"><thead><tr><th>Tarih</th><th>Anomali</th><th>Üretim yoğunluğu</th><th>Titreşim ort.</th></tr></thead><tbody>
                        @foreach(var x in Model.RecentTelemetry){<tr><td>@x.Date.LocalDateTime.ToString("dd.MM.yyyy")</td><td>@x.AnomalyScore.ToString("0.##")</td><td>%@x.ProductionIntensity.ToString("0.##")</td><td>@x.VibrationAverage.ToString("0.##")</td></tr>}
                        @if(Model.RecentTelemetry.Count == 0){<tr><td colspan="4" class="text-muted">Telemetri kaydı bulunamadı.</td></tr>}
                        </tbody></table></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-primary-soft" asp-action="Details" asp-route-id="@Model.Id"><i class="bi bi-box-arrow-up-right"></i> Tam Sayfayı Aç</a>
                @if (Model.CanManage) { <button type="button" class="btn btn-brand" data-modal-url="@Url.Action("Edit", "Machines", new { id = Model.Id })"><i class="bi bi-pencil"></i> Düzenle</button> }
                <button type="button" class="btn btn-primary-soft" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>
