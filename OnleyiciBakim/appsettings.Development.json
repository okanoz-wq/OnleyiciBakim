{
  "ConnectionStrings": {
    "BakimYonetimiSqlServer": "Server=(localdb)\\MSSQLLocalDB;Database=BakimYonetimiDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Database": {
    "Provider": "InMemory",
    "SeedDevelopmentData": true,
    "UseBakimYonetimiReadModel": true
  },
  "HybridRisk": {
    "MlFailurePolicy": "AlgorithmOnlyFallback"
  },
  "MlService": {
    "UseMock": false
  },
  "Erp": {
    "UseMock": true,
    "EnableBackgroundSync": false
  },
  "Swagger": {
    "Enabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
